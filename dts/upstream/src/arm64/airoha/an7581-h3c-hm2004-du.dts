// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
/dts-v1/;

/* BL2 and TF-A reserve the first 2 MiB of DRAM. */
/memreserve/ 0x80000000 0x200000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "en7581.dtsi"

/ {
	model = "H3C HM2004-DU";
	/* AN7581CT (EN7581 family). */
	compatible = "h3c,hm2004-du", "airoha,an7581", "airoha,en7581";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/*
	 * Stock U-Boot env carries dram_limit=512M, so 512 MiB is not only a
	 * fallback: it is the capacity the vendor bootloader publishes. Raise
	 * it only if the board really reports more DRAM.
	 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			/*
			 * TODO(verify): the stock flash records no button GPIO.
			 * GPIO0 is the TCLinux SDK default used by every other
			 * AN7581 TCLinux-derived board (ZN504XG-D, UNG00A); the
			 * recovery entry point depends on it, so re-check on the
			 * first boot (hold Reset ~1 s after power-on).
			 */
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		/*
		 * The LED lines come from the stock U-Boot env:
		 *   power_gpio=1515, ether_gpio=0c, dsl_gpio=13, internet_gpio=14
		 * The vendor encoding is hexadecimal byte pairs: multi_upgrade_gpio
		 * is "110f1011121314181c22000000000000", i.e. 17,15,16,17,18,19,20,
		 * 24,28,34. So the power entry may read as 0x15 = 21 instead of the
		 * decimal 15 used below. 15 is kept because the Linux tree
		 * (target/linux/airoha/dts/an7581-h3c-hm2004-du.dts) uses the same
		 * number; if the power LED stays dark, switch both trees to 21.
		 *
		 * Active-low follows the common AN7581 panel wiring. Keep the
		 * label in sync with bootled_status in the board env file and with
		 * status_led in arch/arm/dts/an7581-h3c-hm2004-du-u-boot.dtsi.
		 */
		led-power {
			label = "green:power";
			gpios = <&en7581_pinctrl 15 GPIO_ACTIVE_LOW>;
			default-state = "keep";
		};
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;
};

&snfi {
	status = "okay";
};

&spi_nand {
	/*
	 * TODO(bring-up): 256 MiB (2 Gibit) SPI-NAND, 2048-byte pages and
	 * 128 KiB erase blocks. U-Boot identifies the part from its JEDEC ID,
	 * so this compatible only selects optional quirks; read the ID from
	 * the U-Boot log and replace it with the real part, e.g.
	 *   "winbond,w25n02kv" / "esmt,f50l2g41xa" / "macronix,mx35lf2ge4ad"
	 */
	compatible = "winbond,w25n02kv", "spi-nand";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bl2";
			/* BootROM reads the BL2 FIP at offset 0x800 in the first eraseblock. */
			reg = <0x00000000 0x00020000>;
		};

		partition@20000 {
			label = "ubi";
			/* A zero length applies the MTD MTDPART_SIZ_FULL convention. */
			reg = <0x00020000 0x00000000>;
		};
	};
};

&eth {
	status = "okay";
};

/*
 * U-Boot recovery only needs gdm1 (internal fixed-link to the switch), so the
 * 2.5G EN8811H PHY and the three GE switch ports are intentionally left out of
 * this tree; they belong to the Linux DTS (target/linux/airoha/dts).
 */
&gdm1 {
	status = "okay";
};
